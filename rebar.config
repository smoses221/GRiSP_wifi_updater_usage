{deps, [
    grisp,
    grisp_updater_grisp2,
    {epmd, {git, "https://github.com/erlang/epmd", {ref, "4d1a59"}}}
]}.

{erl_opts, [debug_info]}.

{project_plugins, [rebar3_grisp]}.

{grisp, [
    {otp, [
        {version, "29"},
        {jit, true}
    ]},
    {deploy, [
        {pre_script, "rm -rf /media/jl/GRISP/*"},
        {destination, "/media/jl/GRISP/"},
        {post_script, "umount /media/jl/GRISP/"}
    ]}
]}.

{shell, [{apps, []}]}.

{relx, [
    {release, {'GRiSP_wifi_updater_test', "0.2.0"}, [
        {epmd, none},
        'GRiSP_wifi_updater_test'
    ]}
]}.
