{deps, [
    grisp
,
    {epmd, {git, "https://github.com/erlang/epmd", {ref, "4d1a59"}}}
]}.

{erl_opts, [debug_info]}.

{project_plugins, [rebar3_grisp]}.

{grisp, [
    {otp, [
        {version, "29"},
        {jit, true}
    ]},
    {deploy, [
        {destination, "/path/to/SD-card"}
    ]}
]}.

{shell, [{apps, []}]}.

{relx, [
    {release, {GRiSP_wifi_updater_test, "0.1.0"}, [
        {epmd, none},
        GRiSP_wifi_updater_test
    ]}
]}.
